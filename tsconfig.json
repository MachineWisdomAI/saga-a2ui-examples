{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-plugin/types"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "apps/tic-tac-toe/src",
    "apps/tic-tac-toe/test",
    "apps/tic-tac-toe/env.d.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "apps/tic-tac-toe/view",
    "apps/tic-tac-toe/browser"
  ]
}
