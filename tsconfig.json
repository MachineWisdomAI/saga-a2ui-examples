{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
    "jsx": "react-jsx"
  },
  "include": ["apps", "vitest.config.ts", ".stage/game/server", ".stage/game/src/contract.ts"],
  "exclude": ["apps/tic-tac-toe/view", "apps/tic-tac-toe/browser"]
}
